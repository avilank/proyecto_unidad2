# =============================================================================
# PredictMaint — monorepo (.gitignore raíz)
# Aplica a todas las subcarpetas: predictmaint-api, predictmaint-web,
# predictmaint-ml, scripts, models, design, etc.
# =============================================================================

# --- Sistema operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDEs y editores ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# --- Node.js (predictmaint-api, predictmaint-web, scripts) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp
.pnp.js
package-lock.json.bak

# --- Build y artefactos compilados ---
dist/
build/
out/
*.tsbuildinfo

# --- Next.js (predictmaint-web) ---
.next/
.vercel/

# --- NestJS / TypeScript ---
coverage/
.nyc_output/

# --- Python (predictmaint-ml, scripts) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.eggs/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Machine Learning (modelos generados por train.py) ---
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.onnx
*.pt
*.pth
/models/
predictmaint-ml/artifacts/*
!predictmaint-ml/artifacts/.gitkeep

# --- Logs y temporales ---
logs/
*.log
tmp/
temp/
.cache/

# --- Docker (datos locales de volúmenes) ---
docker-data/
pgdata/

# --- Bases de datos locales ---
*.sqlite
*.sqlite3
*.db

# --- Archivos comprimidos / backups ---
*.bak
*.backup
*.old
*.orig
*.tmp
backup2
seeds/backup2
*.dump

