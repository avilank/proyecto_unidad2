# --- Base de datos (como lord-academy-services) ---
# Opción A: URL completa
#DATABASE_URL=postgres://predictmaint:predictmaint@localhost:5432/predictmaint

# Opción B: variables sueltas (como lord-academy — tienen prioridad)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_password
DATABASE_NAME=mantto_bd

# Sync al arrancar (dev): crea tablas desde los modelos Sequelize
DATABASE_SYNC=true
DATABASE_ALTER=true
DATABASE_FORCE=false
DATABASE_LOGGING=false

# Seed automático la primera vez (si no hay usuarios en BD)
DATABASE_SEED=true

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# --- ML gateway ---
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=ml-secret-key

# --- Notificaciones (webhook n8n — correo + WhatsApp) ---
SEND_EMAIL_WEBHOOK=https://n8n.yamboly.lat/webhook/acf0882c-1ca1-4656-99d7-6ccd5d8fbc5c
FRONTEND_URL=http://localhost:3000

# Legacy SMTP/WhatsApp directo (no usado si SEND_EMAIL_WEBHOOK está configurado)
WHATSAPP_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

PORT=3001
